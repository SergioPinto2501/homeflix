# Copia questo file in ".env" e modifica i valori.
# Su Windows usa le barre normali nei percorsi (D:/Video), non quelle inverse.

# Cartella con film e serie (domani: il punto di mount dell'SSD, es. /mnt/media)
MEDIA_DIR=./media

# Chiave gratuita di themoviedb.org per locandine, sfondi e trame (lascia vuoto per farne a meno)
TMDB_API_KEY=

# Porta del server
PORT=3000

# Dove salvare il database
DATA_DIR=./data

# Paese per la disponibilità in streaming (codice a due lettere)
TMDB_REGION=IT

# Cartella temporanea per caricamenti e download (default: dentro DATA_DIR)
# UPLOAD_DIR=./data/uploads
